# Privacy Browser Agent — Environment Configuration

# Backend Configuration (Milestone 2+)
BACKEND_URL=http://localhost:8000
BACKEND_WS_URL=ws://localhost:8000

# Cloud AI Provider Selection (Milestone 4+)
# Choose: anthropic (Claude) or openai (GPT)
AI_PROVIDER=openai

# Claude/Anthropic Configuration
# ANTHROPIC_API_KEY=your-claude-api-key-here

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview

# Logging
LOG_LEVEL=info

# Note: Never commit real credentials to version control
# Copy this file to .env and fill in your actual API keys
